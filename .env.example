# Required: WordPress site URL (no trailing slash)
WP_URL=https://example.com

# Required: WordPress username with REST API access
WP_USERNAME=admin

# Required: Application Password (generate at Users > Profile > Application Passwords)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Transport: "stdio" (default) or "http"
WP_MCP_TRANSPORT=stdio

# HTTP transport settings (only used when WP_MCP_TRANSPORT=http)
WP_MCP_PORT=3000
WP_MCP_HOST=127.0.0.1

# Auto-discover custom plugin endpoints (default: true)
WP_MCP_DISCOVER=true
