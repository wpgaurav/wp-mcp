{
  "name": "@wpgaurav/wp-mcp",
  "version": "0.1.7",
  "description": "WordPress MCP Server — expose any WordPress site's REST API as MCP tools with auto-discovery of custom plugin endpoints",
  "type": "module",
  "bin": {
    "wp-mcp": "./dist/bin/wp-mcp.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx bin/wp-mcp.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "wordpress",
    "mcp",
    "model-context-protocol",
    "wp-api",
    "woocommerce",
    "acf"
  ],
  "author": "Gaurav Tiwari",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wpgaurav/wp-mcp.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0"
  }
}
